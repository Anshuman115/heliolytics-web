{
  "name": "heliolytics-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import ./scripts/validate-runtime.mjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --import ./scripts/validate-runtime.mjs node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "auth:hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.15.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
